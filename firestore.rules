rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Since we don't have a complex role system yet, we assume ANY authenticated user is an admin.
    // In a real production system, we would check a user role document.
    function isAdmin() {
      return isAuthenticated(); 
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Public Collections (Read-Only)
    match /blogs/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /pages/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /packages/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /service-categories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /singletons/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /videos/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /videoCategories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Protected Collections (Admin Only)
    match /businessChecks/{document} {
      allow read: if isAdmin();
      // Allow public to create (submit the form), but not update or delete
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    match /members/{document} {
      allow read: if isAdmin();
      // Public can create when they submit forms
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    match /orders/{document} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    match /finance/{document} {
      allow read, write: if isAdmin();
    }
    match /media/{document} {
      allow read: if true; // anyone can view images
      allow write: if isAdmin();
    }
    match /logs/{document} {
      allow read, write: if true;
    }
    match /analytics/{document} {
      allow read, write: if isAdmin();
    }
    match /staff/{document} {
      allow read, write: if isAdmin();
    }
  }
}
